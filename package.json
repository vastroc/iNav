{
  "name": "inav",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build && wrangler dev --port 8787",
    "dev:worker": "wrangler dev --port 8787",
    "dev:ui": "vite --port 5173",
    "setup": "npm run db:migrate && npm run db:seed",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc -p tsconfig.worker.json --noEmit && tsc -p tsconfig.json --noEmit",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:seed": "wrangler d1 execute DB --local --file=./scripts/seed.sql",
    "db:seed:remote": "wrangler d1 execute DB --remote --file=./scripts/seed.sql",
    "db:reset": "wrangler d1 migrations apply DB --local --reset",
    "test:api": "node scripts/smoke-api.mjs"
  },
  "dependencies": {
    "hono": "^4.13.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261026.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "wrangler": "^4.152.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "description": "锦囊书签：可部署在 Cloudflare Workers + D1 的极简公共导航站"
}
