{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "inav",
	"main": "worker/index.ts",
	"compatibility_date": "2026-09-01",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*",
			"/sitemap.xml",
			"/go/*",
			"/admin",
			"/admin/*"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "inav",
			"migrations_dir": "migrations"
		}
	],
	"triggers": {
		"crons": [
			"0 3 * * *"
		]
	},
	"observability": {
		"enabled": true
	}
}