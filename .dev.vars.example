# 本地开发使用

# 复制为 .dev.vars 后填写；.dev.vars 已被 .gitignore 忽略，不要提交。
# 生成 SESSION_SECRET：
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

SESSION_SECRET=请替换为至少16位随机字符串
SITE_URL=http://127.0.0.1:8787

# GitHub OAuth App：https://github.com/settings/developers
# 本地回调 http://127.0.0.1:8787/api/auth/github/callback
# 线上回调 https://你的域名/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# 逗号分隔的管理员 GitHub 用户名
ADMIN_GITHUB_LOGINS=your-github-username

# 可选：AI 自动简介
# AI_API_KEY=
# AI_BASE_URL=
# DEEPSEEK_API_KEY=
# GEMINI_API_KEY=
